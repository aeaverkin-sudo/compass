{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/lock-screens.mjs"
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/lock-screens.mjs",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/lock-screens.mjs",
        "failClosed": true
      }
    ]
  }
}
